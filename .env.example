# ---------- Core ----------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
# Production only:
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
# ADMIN_URL=staff-<random>/          # hide the admin from the well-known /admin/ path
# DATABASE_URL=postgres://user:pass@host:5432/tunehub
# REDIS_URL=redis://localhost:6379/0  # shared cache so rate limits work across workers
# RATELIMIT_PROXY_COUNT=1             # number of trusted reverse proxies in front of the app
# PRIVATE_MEDIA_ROOT=/data/private_media
# LOG_LEVEL=INFO

# ---------- Stripe (leave empty locally to use the simulated "test subscription") ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_AUTOMATIC_TAX=True

# ---------- Email (console backend by default) ----------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=TuneHub <no-reply@your-domain.com>

# ---------- Uploads ----------
# ATTACHMENT_MAX_BYTES=10485760
# ATTACHMENT_MAX_PER_ENTRY=5
